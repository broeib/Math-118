\vskip 0.1truein

\begin{enumerate}

\item Verify that the following matrices are orthogonal. {\em Note there may be a little bit of rounding error.} \\
$$
Q_1 = \left[\begin{matrix} 0.1817 & 0.7236 & 0.6658 \\ 0.6198 & -0.61 & 0.4938 \\ -0.7634 & -0.3230 & 0.5594 \end{matrix}\right] \quad Q_2 = \left[\begin{matrix} 0.6404 & 0.3577 & -0.6797 \\ -0.3121 & 0.9298 & 0.1952 \\ 0.7010 & 0.0872 & 0.7071 \end{matrix}\right]
$$

\item Consider the least squares problem $\displaystyle \bfx^{*} = \argmin_{\bfx\in\mathbb{R}^{4}} \|A\bfx - \bfb\|_{2}$ where $A$ and $\bfb$ are given below. Find $\bfx^{*}$ using the QR decomposition method, where $Q$ and $R$ are also given below.
\begin{align*}
& A = \left[\begin{matrix} 0.7922 & 0.6787 & 0.7060 & 0.6948 \\ 0.9595 & 0.7577 & 0.0318 & 0.3171 \\ 0.6557 & 0.7431 & 0.2769 & 0.9502 \\ 0.0357 & 0.3922 & 0.0462 & 0.0344 \\ 0.8491 & 0.6555 & 0.0971 & 0.4387 \\ 0.9340 & 0.1712 & 0.8235 & 0.3816 \end{matrix} \right] \quad \bfb = \left[\begin{matrix} 0.7655 \\ 0.7952 \\ 0.1869 \\ 0.4898 \\ 0.4456 \\ 0.6463 \end{matrix}\right] \\
&  Q = \left[\begin{matrix} -0.4191 & -0.1861 & -0.5979 & -0.1311 & -0.2584 & -0.5901 \\ -0.5076 & -0.1321 & 0.5495 & -0.3017 & -0.5548 & 0.1553 \\ -0.3469 & -0.4172 & -0.1468 & 0.7373 & -0.0250 & 0.3739 \\ -0.0189 & -0.5331 & -0.2732 & -0.5822 & 0.3160 & 0.4494 \\ -0.4492 & -0.0950 & 0.3924 & 0.0215 & 0.7089 & -0.3637 \\ -0.4941 & 0.6933 & -0.3005 & -0.0938 & 0.1500 & 0.3919 \end{matrix}\right] \quad R_1 = \left[\begin{matrix} -1.8902 & -1.3134 & -0.8595 & -1.1681 \\ 0 & -0.6892 & 0.2859 & -0.3632 \\ 0 & 0 & -0.6673 & -0.3327 \\ 0 & 0 & 0 & 0.4674 \end{matrix}\right]
\end{align*}

\item {\bf (Optional)} Verify your answer from question 2 using a computer. You can use either $A\setminus\bfb$ in MATLAB or {\tt np.linalg.lstsq(A,b)} in Python. Note that you can also verify the QR decomposition by using the command {\tt qr(A)} in MATLAB or  {\tt np.linalg.qr(A)} in Python.

\item Prove that if $Q_1$ and $Q_2$ are orthogonal then so is $Q_1Q_2$. {\em Hint: There are multiple ways to show this. You may want to prove that all the columns of the new matrix $Q_1Q_2$ are orthonormal. Or you may want to show that $(Q_1Q_2)^{-1} = (Q_1Q_2)^{\top}$.} \\

\item For all parts of this question let $A = \left[\begin{matrix} 3 & 3  & 1 \\ 3 & 2 & 2 \\ 1 & 1 & 3 \end{matrix}\right]$ 

\begin{enumerate}
\item Find the eigenvalues \st{and corresponding eigenvectors of $A$.} \\
\item Use your answer to part (a) to compute $\|A\|_2$. \\
\item {\bf (Optional)} Verify your answer to part (a) using a computer. You can use either {\tt eig(A)} on MATLAB or {\tt np.linalg.eig(A)} in Python. \\ 
\end{enumerate}

\vspace{0.3cm}
\begin{center}
{\bf The following questions are on the singular value decomposition.}
\end{center}
\vspace{0.3cm}

\item Suppose that $\bfu_1,\ldots, \bfu_{n}$ are orthonormal, and that $\bfv_1,\ldots, \bfv_n$ are also orthonormal. Let $\sigma_1 > \sigma_2 > \ldots > \sigma_r > 0$. Show that $A_{r} = \sum_{i=1}^{r}\sigma_i \bfu_{i}\bfv_{i}^{\top}$ has rank $r$. {\em Hint: Find a basis for the range of $A_r$}. \\


\vspace{0.3cm}
\begin{center}
{\bf The following questions are on tensors.}
\end{center}
\vspace{0.3cm}

\item Let $\mathcal{G}$ be a $2\times 2\times 2$ tensor with slices:
$$
\mathcal{G}(:,:,1) = \left[\begin{matrix} 1 & 2 \\ -2 & 1 \end{matrix}\right] \quad \mathcal{G}(:,:,2) = \left[\begin{matrix} -2 & 1 \\ 1 & 2 \end{matrix}\right]
$$

Furthermore, let:
$$
A = \left[\begin{matrix} 1 & 4 \\ 2 & 5 \\ 3 & 6 \end{matrix}\right] \quad B = \left[\begin{matrix} -2 & 2 \\ 3 & -3 \\ -4 & -4 \end{matrix}\right] \quad \text{ and } C = \left[\begin{matrix} 1 & 0 \\ 0 & -1 \end{matrix}\right]
$$
Calculate $\mathcal{G}\times_1A\times_2 B \times_3 C$.
\end{enumerate}


