%% Exercises
\newpage
\subsection*{Ex. 1}
Consider a vector $\mathbf{v}=[2,1,5]^\top$. Compute $\|\mathbf{v}\|_1, \|\mathbf{v}\|_2$, and $\|\mathbf{v}\|_{\infty}$.

\paragraph{Solution:}
\begin{align}
    &\|\mathbf{v}\|_1 = 2+1+5 = 8,\label{eq:ex1}\\
    &\|\mathbf{v}\|_2 = \sqrt{2^2+1^2+5^2} = \sqrt{30},\nonumber\\
    &\|\mathbf{v}\|_{\infty} = \max \{ 2, 1, 5 \} = 5.\nonumber
\end{align}

\subsection*{Ex. 2}
Consider a matrix $A=\begin{bmatrix}
&2 &-1 &3\\
&0 &1 &-2\\
&4 &1 &3
\end{bmatrix}
$. Please compute $\|A\|_1$ and $\|A\|_{\infty}$.

\paragraph{Solution:}
By definition, we have that
\begin{align}
    \|A\|_1 = \max_{1\leq j\leq3} \sum_{i=1}^3 |a_{ij}|\nonumber.
\end{align}
Plugging in the value of $A$, we can get that $\|A\|_1=8$. Also by definition, we have that
\begin{align}
    \|A\|_{\infty} = \max_{1\leq i\leq 3} \sum_{j=1}^3 |a_{ij}|\nonumber.
\end{align}
With the value of $A$, we can get that $\|A\|_{\infty}=8$.

\subsection*{Ex. 3}
Consider a matrix $A\in\mathbb{R}^{m\times n}$. Please show that $\|A\|_1=\max_{1\leq j \leq n}\sum_{i=1}^m |a_{ij}|$.
\begin{proof}
We denote by $M:=\max_{1\leq j \leq n}\sum_{i=1}^m |a_{ij}|$. By definition, $\|A\|_1 = \max_{\|\mathbf{x}\|_1=1} \|A\mathbf{x}\|_1$. Without loss of generality, suppose the first column of A has the maximum $l_1$ norm, i.e. $\sum_{i=1}^m |a_{i1}|=M$. Let $\mathbf{x}=\mathbf{e}_1:=[1,0,\dots, 0]^\top\in\mathbb{R}^n$, it holds that $\|A\|_1=\|A\mathbf{e}_1\|_1 =\sum_{i=1}^m |a_{i1}|=M.$
Therefore, $\|A\|_1\geq M$. On the other hand, 
\begin{align}
    \|A\|_1 &= \max_{\|\bfx\|_1=1}\sum_{i=1}^m \Big|\sum_{j=1}^n a_{ij}x_j\Big|\nonumber\\
    &\leq  \max_{\|\bfx\|_1=1}\sum_{i=1}^m \sum_{j=1}^n|a_{ij}|\cdot|x_j|=\max_{\|\bfx\|_1=1}\sum_{j=1}^n\sum_{i=1}^m|a_{ij}|\cdot|x_j|\nonumber\\
    &\leq \max_{\|\bfx\|_1=1}\sum_{j=1}^n M|x_j|= M.\nonumber
\end{align}
Combining these two results, we have that $\|A\|_1=M$.
\end{proof}





